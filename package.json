{
  "name": "pokeguru",
  "private": true,
  "version": "1.11.0",
  "description": "PokeGuru \u2014 an open Pok\u00e9mon TCG card database: card search, every set, GBP reference prices, a private collection vault and a free pack-opening simulator.",
  "author": "LIN4CRE",
  "license": "MIT",
  "repository": "github:DLinacre/PokeGuru",
  "bugs": {
    "url": "https://github.com/DLinacre/PokeGuru/issues"
  },
  "homepage": "https://pokeguru.vercel.app",
  "type": "module",
  "overrides": {
    "esbuild": "0.28.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "node scripts/build-pages.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-brand-assets.mjs",
    "lint": "eslint .",
    "brand": "node scripts/generate-brand-assets.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "clsx": "2.1.1",
    "lucide-react": "^1.18.0",
    "pdf-lib": "^1.17.1",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.17.0",
    "tailwind-merge": "3.4.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "jsqr": "^1.4.0",
    "sharp": "^0.35.5",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  }
}
