{
  "name": "pokeguru",
  "private": true,
  "version": "1.6.0",
  "description": "Pokémon TCG card database with pricing, set browsing, and card scanning",
  "author": "LIN4CRE",
  "license": "MIT",
  "repository": "github:LIN4CRE/PokeGuru",
  "bugs": "https://github.com/DLinacre/PokeGuru/issues",
  "homepage": "https://dlinacre.github.io/PokeGuru",
  "type": "module",
  "overrides": {
    "esbuild": "0.28.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "DEPLOY_TARGET=github-pages vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "deploy": "npm run build:pages && npx gh-pages -d dist -m \"deploy: $(git log --oneline -1)\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "clsx": "2.1.1",
    "lucide-react": "^1.18.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.17.0",
    "tailwind-merge": "3.4.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "gh-pages": "^6.3.0",
    "jsdom": "^31.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  }
}
