# PokeGuru environment variables
# Copy to .env (or set these in the Vercel project settings).
# Everything here is PUBLIC (Vite inlines VITE_* at build time) — never put
# secrets, API keys or tokens in this file. PokeGuru needs no API keys.

# Canonical public origin, with no trailing slash, e.g. https://pokeguru.example.com
# Used for canonical links, Open Graph URLs, robots.txt, sitemap.xml AND the QR
# code on the printable 5 x 6 in flyer.
# Defaults to https://pokeguru.vercel.app, so a local, preview or mirror build
# still canonicalises to the official deployment. Set it only when you fork
# PokeGuru to your own domain.
VITE_PUBLIC_SITE_URL=

# "Buy Me a Pack" support destination (a real, verified payment/support page).
# If empty, the button renders in a documented "not configured" state rather
# than linking to a fabricated destination.
VITE_BUY_ME_A_PACK_URL=

# Build target. Leave empty (or unset) for Vercel/standard hosting, which
# builds with base "/". Set to "github-pages" only for the secondary GitHub
# Pages deployment, which builds with base "/PokeGuru/".
DEPLOY_TARGET=
